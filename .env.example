# --- LLM (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Default for a 12GB card (RX 6700 XT): Gemma 4 12B, ~8GB at Q4.
OLLAMA_MODEL=gemma4:12b
# Keep the model loaded in VRAM between turns.
OLLAMA_KEEP_ALIVE=30m
# For thinking models (e.g. Qwen) set to false to avoid long "thinking" delays.
# Leave empty to not send the option at all.
OLLAMA_THINK=
LLM_TEMPERATURE=0.7

# --- Speech to text ---
# whispercpp: talks to a running whisper.cpp `whisper-server` (Vulkan build uses the AMD GPU)
# faster-whisper: runs Whisper on the CPU inside this app (pip install -r requirements-cpu-stt.txt)
STT_BACKEND=whispercpp
WHISPER_SERVER_URL=http://127.0.0.1:8178
FASTER_WHISPER_MODEL=large-v3-turbo
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- Web server ---
HOST=127.0.0.1
PORT=8000
